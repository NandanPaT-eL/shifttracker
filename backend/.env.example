# Rename this file to ".env" and paste your MongoDB Atlas connection string below.
# In Atlas: Database > Connect > Drivers > copy the connection string, then
# replace <password> with your database user's password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/shift_tracker?retryWrites=true&w=majority

# Port the API server runs on (optional, defaults to 5050)
PORT=5050
